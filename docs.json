{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "getclean",
  "colors": {
    "primary": "#007D79",
    "light": "#08BDBA",
    "dark": "#007D79"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "For agents",
            "pages": [
              "agents/mcp-server"
            ]
          },
          {
            "group": "Understand",
            "pages": [
              "understand/how-an-answer-reads",
              "understand/records-and-the-hold"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/the-research-loop",
              "guides/search",
              "guides/fetch-a-page",
              "guides/read-a-held-record"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Using the API",
            "pages": [
              "api-reference/overview",
              "api-reference/problems",
              "api-reference/headers",
              "api-reference/idempotency-and-retries",
              "api-reference/limits-and-prices"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://getclean.ai"
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:hello@getclean.ai?subject=contact%20sales",
        "label": "Contact sales"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.getclean.ai/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/deterministic-labs",
      "website": "https://getclean.ai"
    },
    "links": [
      {
        "header": "For machines",
        "items": [
          {
            "label": "llms.txt",
            "href": "https://docs.getclean.ai/llms.txt"
          },
          {
            "label": "llms-full.txt",
            "href": "https://docs.getclean.ai/llms-full.txt"
          },
          {
            "label": "openapi.yaml",
            "href": "https://docs.getclean.ai/openapi.yaml"
          }
        ]
      },
      {
        "header": "Write to us",
        "items": [
          {
            "label": "hello@getclean.ai",
            "href": "mailto:hello@getclean.ai"
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "interaction": {
    "drilldown": false
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "bash"
      ],
      "prefill": false,
      "autogenerate": true
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark",
    "latex": false
  },
  "description": "GetClean is the data layer for research done by agents. It fetches a web page or a document as clean, exact text with the facts of its source, holds the record so every later question about it is answered from the same copy, and searches the web and named sources with a receipt of what ran.",
  "search": {
    "prompt": "Search the docs"
  },
