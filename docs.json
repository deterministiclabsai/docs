  "banner": {
    "content": "The API is in closed early access. Early access is by mail to [hello@getclean.ai](mailto:hello@getclean.ai).",
    "dismissible": false
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "There is no page at this address.",
      "description": "Search the docs, or start again from the [introduction](/)."
    }
  },
  "markdown": {
    "schema": true,
    "instructions": [
      "The GetClean API is at https://api.getclean.ai, every path under /v1. Every call carries Authorization: Bearer with an API key from https://app.getclean.ai or an access token from https://auth.getclean.ai/realms/getclean.",
      "GetClean's MCP server is named getclean, at https://mcp.getclean.ai/mcp. The /mcp path of this docs site is a different server that only searches these docs.",
      "Every GetClean answer opens with outcome. A page that could not be read is a record whose outcome says why, never an HTTP error, so read outcome before anything else.",
      "The API's contract is the OpenAPI 3.1 file at https://docs.getclean.ai/openapi.yaml."
    ]
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
